generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  MANAGER
  RECEPTIONIST
  ACCOUNTANT
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Department {
  FRONT_DESK
  HOUSEKEEPING
  KITCHEN
  MAINTENANCE
  MANAGEMENT
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  MAINTENANCE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  REFUNDED
}

enum HousekeepingTaskType {
  CLEANING
  TURNOVER
  DEEP_CLEAN
  INSPECTION
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum HousekeepingPriority {
  NORMAL
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  TELEBIRR
  CBE_BIRR
  BANK_TRANSFER
  CARD
  OTHER
}

model User {
  id           String     @id @default(cuid())
  fullName     String
  username     String     @unique
  passwordHash String
  role         UserRole   @default(STAFF)
  department   Department?
  status       UserStatus @default(ACTIVE)
  phone        String?
  email        String?    @unique
  salary       Decimal?   @db.Decimal(12, 2)
  startDate    DateTime?
  profileImage String?

  payments              Payment[]
  expenses              Expense[]
  housekeepingTasks     HousekeepingTask[]
  maintenanceRequests   MaintenanceRequest[]
  auditLogs             AuditLog[]
  createdBookings       Booking[] @relation("CreatedBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
  @@index([department])
}

model RoomType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  basePrice   Decimal  @db.Decimal(12, 2)
  maxGuests   Int
  beds        Int      @default(1)

  rooms Room[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          String     @id @default(cuid())
  roomNumber  String     @unique
  floor       String?
  status      RoomStatus @default(AVAILABLE)
  price       Decimal?   @db.Decimal(12, 2)
  description String?
  imageUrl    String?

  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id])

  bookings            Booking[]
  housekeepingTasks   HousekeepingTask[]
  maintenanceRequests MaintenanceRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([roomTypeId])
}

model Guest {
  id             String    @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  gender         String?
  dateOfBirth    DateTime?
  nationality    String?
  idType         String?
  idNumber       String?
  address        String?
  emergencyName  String?
  emergencyPhone String?
  photoUrl       String?
  idDocumentUrl  String?
  notes          String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
  @@index([phone])
  @@index([idNumber])
}

model Booking {
  id             String        @id @default(cuid())
  bookingNumber  String        @unique
  checkInDate    DateTime
  checkOutDate   DateTime
  numberOfGuests Int           @default(1)
  pricePerNight  Decimal       @db.Decimal(12, 2)
  nights         Int
  subtotal       Decimal       @db.Decimal(12, 2)
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  tax            Decimal       @default(0) @db.Decimal(12, 2)
  additionalFees Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  balance        Decimal       @default(0) @db.Decimal(12, 2)

  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  notes         String?

  guestId     String
  roomId      String
  createdById String?

  guest     Guest @relation(fields: [guestId], references: [id])
  room      Room  @relation(fields: [roomId], references: [id])
  createdBy User? @relation("CreatedBookings", fields: [createdById], references: [id])

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([roomId])
  @@index([checkInDate])
  @@index([checkOutDate])
  @@index([status])
}

model Payment {
  id            String        @id @default(cuid())
  receiptNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  method        PaymentMethod
  reference     String?
  notes         String?

  bookingId    String
  receivedById String

  booking    Booking @relation(fields: [bookingId], references: [id])
  receivedBy User    @relation(fields: [receivedById], references: [id])

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([createdAt])
}

model Expense {
  id          String               @id @default(cuid())
  amount      Decimal              @db.Decimal(12, 2)
  category    String
  description String?
  method      ExpensePaymentMethod
  receiptUrl  String?
  notes       String?

  recordedById String
  recordedBy   User @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model InventoryItem {
  id            String    @id @default(cuid())
  name          String
  category      String
  sku           String?   @unique
  quantity      Decimal   @default(0) @db.Decimal(12, 2)
  minimumStock  Decimal   @default(0) @db.Decimal(12, 2)
  unit          String
  purchasePrice Decimal   @default(0) @db.Decimal(12, 2)
  supplier      String?
  location      String?
  expiryDate    DateTime?
  notes         String?

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([quantity])
}

model InventoryTransaction {
  id        String   @id @default(cuid())
  type      String
  quantity  Decimal  @db.Decimal(12, 2)
  reason    String?
  createdAt DateTime @default(now())

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id])

  @@index([itemId])
  @@index([createdAt])
}

model HousekeepingTask {
  id       String                  @id @default(cuid())
  type     HousekeepingTaskType    @default(CLEANING)
  status   HousekeepingTaskStatus  @default(PENDING)
  priority HousekeepingPriority    @default(NORMAL)
  notes    String?

  roomId       String
  assignedToId String?

  room       Room  @relation(fields: [roomId], references: [id])
  assignedTo User? @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([status])
  @@index([type])
}

model MaintenanceRequest {
  id          String            @id @default(cuid())
  title       String
  description String?
  priority    String            @default("MEDIUM")
  status      MaintenanceStatus @default(OPEN)
  cost        Decimal           @default(0) @db.Decimal(12, 2)
  completedAt DateTime?

  roomId       String
  assignedToId String?

  room       Room  @relation(fields: [roomId], references: [id])
  assignedTo User? @relation(fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?

  userId String
  user   User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Notification {
  id      String @id @default(cuid())
  title   String
  message String
  type    String
  read    Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([read])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
